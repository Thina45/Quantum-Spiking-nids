{
  "config": {
    "data": {
      "dataset": "cicids2017",
      "root": "data/raw/cicids2017",
      "cache_dir": "data/processed",
      "max_rows": 300000,
      "balance": "undersample",
      "binary": true,
      "min_class_count": 500,
      "scaler": "quantile",
      "select_k": 40,
      "reducer": "pca",
      "n_features": 8,
      "test_size": 0.2,
      "val_size": 0.1,
      "seed": 42,
      "n_jobs": -1
    },
    "encoding": {
      "scheme": "phase",
      "timesteps": 12,
      "gain": 1.0,
      "tau": 3.0,
      "deterministic": false,
      "seed": 42
    },
    "model": {
      "n_qubits": 8,
      "n_qlif_layers": 2,
      "ansatz_layers": 2,
      "ansatz": "strong",
      "beta": 0.9,
      "learn_beta": true,
      "threshold": 0.55,
      "learn_threshold": false,
      "reset": "subtract",
      "angle_map": "sigmoid",
      "angle_gain": 2.0,
      "angle_bias": -2.0,
      "surrogate": "fast_sigmoid",
