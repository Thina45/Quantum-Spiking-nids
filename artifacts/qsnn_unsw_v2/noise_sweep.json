      "grad_clip": 1.0,
      "patience": 8,
      "device": "auto",
      "num_workers": 0,
      "amp": false,
      "log_every": 50,
      "out_dir": "artifacts",
      "run_name": "qsnn_unsw",
      "save_best": true,
      "seed": 42
    },
    "baselines": {
