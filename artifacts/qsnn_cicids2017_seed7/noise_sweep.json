      "focal_gamma": 2.0,
      "grad_clip": 1.0,
      "patience": 8,
      "device": "auto",
      "num_workers": 0,
      "amp": false,
      "log_every": 50,
      "out_dir": "artifacts",
      "run_name": "qsnn_cicids2017",
      "save_best": true,
      "seed": 42
    },
    "baselines": {
      "enabled": [
        "rf",
        "svm",
        "mlp",
        "qsvc",
        "qcnn"
